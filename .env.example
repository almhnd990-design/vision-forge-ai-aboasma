# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required for production auth/data layer)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Protects server-to-server background agent execution
AGENT_RUN_SECRET=

# AI provider — server side only. Configure at least one before enabling AI reasoning.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Integrations — add only when each connector is activated
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
STRIPE_SECRET_KEY=
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
AMAZON_SP_API_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
