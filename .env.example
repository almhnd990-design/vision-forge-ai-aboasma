# =====================================================================
# GhostOps AI — environment contract
#
# Copy to `.env.local` and fill in what you need. Nothing here is required to run
# the deterministic analysis engine or to view the site.
#
# Each capability is gated on its own variables:
#   - Accounts + cloud persistence : Supabase (3 variables)
#   - Paid subscriptions           : Stripe (5 variables) + Supabase service role
#   - Provider connector           : CONNECTOR_ENCRYPTION_KEY
#   - AI reasoning                 : OPENAI_API_KEY or DEEPSEEK_API_KEY
# Run `npm run check:env` to see exactly which capabilities are live.
# =====================================================================

# ---- Application -----------------------------------------------------------
# Used for canonical URLs, OpenGraph metadata, hreflang and Stripe return URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase: authentication and the tenant database ----------------------
# Required before any paid product can work. Without these, sign-in and cloud
# storage are disabled and the API returns 503 rather than pretending to work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security, so it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe: subscriptions ------------------------------------------------
# Billing is treated as UNCONFIGURED until all five of these are set, so a
# half-configured account can never take a payment.
STRIPE_SECRET_KEY=
# From the webhook endpoint's signing secret. Every webhook is signature-verified.
STRIPE_WEBHOOK_SECRET=
# One price ID per plan. These are the only place plan-to-price mapping lives,
# together with lib/plans.ts. Create the prices in Stripe with these amounts:
#   Starter SAR 99/month, Growth SAR 299/month, Scale SAR 799/month
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# ---- Connector credential encryption -------------------------------------
# 32 bytes, hex (64 chars) or base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required before any provider credential can be stored. Credentials are sealed
# with AES-256-GCM and kept in a table no client can read.
CONNECTOR_ENCRYPTION_KEY=

# ---- AI reasoning (optional) ---------------------------------------------
# Configure at least one. Without a key the deterministic engine still runs and
# the UI states plainly that advanced reasoning is unavailable.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Optional model overrides. Defaults: gpt-4o-mini / deepseek-chat
OPENAI_MODEL=
DEEPSEEK_MODEL=

# ---- Machine endpoint (optional) -----------------------------------------
# Protects POST /api/agent/run for server-to-server callers.
# This is NOT customer authentication and is not used by any customer-facing route.
AGENT_RUN_SECRET=

# ---- Providers that are NOT implemented yet ------------------------------
# These are listed so the future OAuth work has a place to land. Setting them
# does NOT make the connector work: the connector code does not exist yet, and
# the UI keeps showing "Coming soon".
#   Shopify  -> planned
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
#   Amazon SP-API -> planned
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
AMAZON_SP_API_REFRESH_TOKEN=
#   Gmail -> planned
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
